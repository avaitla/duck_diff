# OPTIONAL convenience: copy to `.env` (gitignored) and fill in what the demo
# you're running needs. run.sh and report.sh source it automatically if it
# exists — exporting the variables in your shell (or injecting them with a
# secret-manager wrapper like `op run --` / `doppler run --`) works exactly
# the same without this file. If a variable is set in both places, the .env
# value wins (it is sourced last).

## MySQL — mysql_primary_vs_replica.sql, mysql_vs_bigquery.sql
MYSQL_HOST=primary.abc123.us-east-1.rds.amazonaws.com
MYSQL_REPLICA_HOST=replica.abc123.us-east-1.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_REPLICA_PORT=3306
MYSQL_DATABASE=appdb
MYSQL_USER=readonly
MYSQL_PASSWORD=

## BigQuery — mysql_vs_bigquery.sql (auth = Application Default Credentials)
BQ_PROJECT=my-gcp-project
# Either point at a service-account key…
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# …or delete that line and use `gcloud auth application-default login`.

## Postgres — postgres_vs_snowflake.sql, postgres_vs_s3tables.sql,
## postgres_vs_clickhouse.sql
PGHOST=prod-db.internal
PGPORT=5432
PGDATABASE=appdb
PGUSER=readonly
PGPASSWORD=

## Snowflake — postgres_vs_snowflake.sql
SNOWFLAKE_ACCOUNT=xy12345.us-east-1
SNOWFLAKE_USER=REPORTING
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=ANALYTICS
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

## ClickHouse — clickhouse_vs_s3_parquet.sql, postgres_vs_clickhouse.sql
## (HTTP interface; for ClickHouse Cloud use https://<instance>.clickhouse.cloud:8443)
CLICKHOUSE_URL=https://ch.internal:8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

## AWS / S3 — any demo touching s3:// (parquet, iceberg, ducklake, s3 tables).
# The demos use PROVIDER credential_chain, i.e. the standard AWS chain:
# these env vars, else your ~/.aws profile / SSO, else an attached IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# AWS_PROFILE=analytics    # alternative to the two keys above

## S3 paths — clickhouse_vs_s3_parquet.sql, iceberg_vs_ducklake.sql
CLICKS_S3_GLOB=s3://my-bucket/exports/clicks/*.parquet
ICEBERG_ORDERS_PATH=s3://my-bucket/warehouse/sales/orders

## DuckLake — iceberg_vs_ducklake.sql (Postgres catalog + S3 data)
DUCKLAKE_DATA_PATH=s3://my-bucket/lake/
DUCKLAKE_PG_HOST=lake-catalog.internal
DUCKLAKE_PG_PORT=5432
DUCKLAKE_PG_DATABASE=ducklake_catalog
DUCKLAKE_PG_USER=ducklake
DUCKLAKE_PG_PASSWORD=
