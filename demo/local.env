# Environment for the docker-compose playground (`docker compose up -d --wait`).
# Committed on purpose: every value is a throwaway dev credential for the
# local containers, not a secret. Use it with `cp local.env .env`, or
# `set -a; source local.env; set +a` in your shell.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_REPLICA_HOST=127.0.0.1
MYSQL_REPLICA_PORT=13307
MYSQL_DATABASE=appdb
MYSQL_USER=duck
MYSQL_PASSWORD=duckdemo

PGHOST=127.0.0.1
PGPORT=15432
PGDATABASE=appdb
PGUSER=duck
PGPASSWORD=duckdemo

CLICKHOUSE_URL=http://127.0.0.1:18123
CLICKHOUSE_USER=duck
CLICKHOUSE_PASSWORD=duckdemo

# Local path — the demo reads it with read_parquet(getenv('CLICKS_S3_GLOB')),
# which accepts local paths and s3:// URLs alike. Relative to demo/.
CLICKS_S3_GLOB=docker/clicks.parquet
